@page "/libros"
@using BlazorBiblioteca.Shared.Models
@using BlazorBiblioteca.Client.Services
@inject LibroService libroService

<style>

    body {
        background: linear-gradient(to right, #141e30, #243b55);
    }

    .overlay-loading {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

</style>

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0 mb-4">

                <div class="card-body p-4">

                    <h2 class="text-center mb-4">
                        📚 Biblioteca William Wallace
                    </h2>

                    <EditForm Model="@libro"
                              OnValidSubmit="GuardarLibro"
                              FormName="formLibro">

                        <DataAnnotationsValidator />

                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Nombre Libro
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="libro.NombreLibro" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Autor
                            </label>

                            <InputText class="form-control"
                                       @bind-Value="libro.Autor" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label fw-bold">
                                Número de páginas
                            </label>

                            <InputNumber class="form-control"
                                         @bind-Value="libro.NumPaginas" />

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Fecha de publicación
                            </label>

                            <InputDate class="form-control"
                                       @bind-Value="libro.FechaPublicacion" />

                        </div>

                        <div class="d-grid">

                            @if (libro.Id == 0)
                            {
                                <button type="submit"
                                        class="btn btn-outline-success btn-lg">

                                    Guardar Libro

                                </button>
                            }
                            else
                            {
                                <button type="submit"
                                        class="btn btn-warning btn-md">

                                    Actualizar Libro

                                </button>
                            }

                        </div>

                    </EditForm>

                </div>

            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @tipoAlerta">
                    @mensaje
                </div>
            }

            <div class="card shadow-lg border-0">

                <div class="card-body">

                    <h3 class="mb-4">
                        Lista de Libros
                    </h3>

                    @if (libros == null || libros.Count == 0)
                    {
                        <div class="alert alert-warning">
                            No existen libros en la biblioteca actualmente
                        </div>
                    }
                    else
                    {
                        <div class="list-group">

                            @foreach (var item in libros)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center"
                                     @key="item.Id">

                                    <div>

                                        <h5 class="mb-1">
                                            @item.NombreLibro
                                        </h5>

                                        <small class="text-muted">
                                            @item.Autor
                                        </small>

                                        <br />

                                        <small>
                                            Páginas: @item.NumPaginas
                                        </small>

                                        <br />

                                        <small>
                                            Fecha:
                                            @item.FechaPublicacion.ToShortDateString()
                                        </small>

                                    </div>

                                    <div class="d-flex gap-2">

                                        <button class="btn btn-warning btn-sm"
                                                @onclick="() => EditarLibro(item)">

                                            Editar

                                        </button>

                                        <button class="btn btn-outline-danger btn-sm"
                                                @onclick="() => Eliminar(item.Id)">

                                            Eliminar

                                        </button>

                                    </div>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@if (cargando)
{
    <div class="overlay-loading">

        <div class="text-center">

            <div class="spinner-border text-light"
                 style="width:5rem;height:5rem;"
                 role="status">
            </div>

            <h4 class="text-white mt-3">
                Procesando...
            </h4>

        </div>

    </div>
}

@code {

    private List<Libro> libros = new();

    private Libro libro = new Libro();

    private string mensaje = "";

    private string tipoAlerta = "";

    private bool cargando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarLibros();
    }

    private async Task CargarLibros()
    {
        libros = await libroService.GetLibros();
    }

    private async Task GuardarLibro()
    {
        cargando = true;

        StateHasChanged();

        await Task.Delay(3000);

        if (libro.Id == 0)
        {
            mensaje = await libroService.CrearLibro(libro);

            tipoAlerta = "alert-success";
        }
        else
        {
            mensaje = await libroService.ActualizarLibro(libro);

            tipoAlerta = "alert-warning";
        }

        libro = new Libro();

        await CargarLibros();

        cargando = false;
    }

    private void EditarLibro(Libro item)
    {
        libro = new Libro
        {
            Id = item.Id,
            NombreLibro = item.NombreLibro,
            Autor = item.Autor,
            NumPaginas = item.NumPaginas,
            FechaPublicacion = item.FechaPublicacion
        };
    }

    private async Task Eliminar(int id)
    {
        cargando = true;

        StateHasChanged();

        await Task.Delay(2000);

        mensaje = await libroService.EliminarLibro(id);

        tipoAlerta = "alert-danger";

        await CargarLibros();

        cargando = false;
    }
}